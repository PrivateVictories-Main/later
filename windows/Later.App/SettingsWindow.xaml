<Window x:Class="Later.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Later.App.Controls"
        xmlns:local="using:Later.App"
        Title="Later Settings">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Grid.Row="0" Padding="14,0,140,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Later-512.png" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="Later Settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="PageStack" Padding="24,8,24,24" Spacing="2">

        <!-- Later's name, and what it is doing right now. -->
        <Grid ColumnSpacing="16" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Source="ms-appx:///Assets/Later-512.png" Width="56" Height="56" AutomationProperties.AccessibilityView="Raw" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="Later" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="GoodDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource StatusGoodBrush}" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
              <Ellipse x:Name="WarningDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource StatusWarningBrush}" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
              <Ellipse x:Name="QuietDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock x:Name="SummaryText" Grid.Column="1" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" AutomationProperties.LiveSetting="Polite" />
            </Grid>
          </StackPanel>
        </Grid>

        <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,10,0,6" AutomationProperties.HeadingLevel="Level2" />
        <controls:SettingRow Glyph="&#xE7E8;" TileBrush="{ThemeResource TileGreenBrush}" Title="Start at sign-in"
                             Detail="Later keeps watching in the background, even when its window is closed.">
          <ToggleSwitch x:Name="StartSwitch" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnStartToggled" />
        </controls:SettingRow>
        <Border x:Name="StartNotePanel" Visibility="Collapsed" Padding="14,12" CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource StatusWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" IsTextScaleFactorEnabled="False"
                      AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="10">
              <TextBlock x:Name="StartNoteText" TextWrapping="WrapWholeWords" AutomationProperties.LiveSetting="Polite" />
              <Button Content="Open Startup apps" Click="OnOpenStartupApps" />
            </StackPanel>
          </Grid>
        </Border>
        <controls:SettingRow Glyph="&#xE769;" TileBrush="{ThemeResource TileOrangeBrush}" Title="Pause watching"
                             Detail="Later stops keeping new pages until you turn this back on.">
          <ToggleSwitch x:Name="PauseSwitch" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnPauseToggled" />
        </controls:SettingRow>
        <controls:SettingRow Glyph="&#xE8F1;" TileBrush="{ThemeResource TileIndigoBrush}" Title="Also save feed home pages"
                             Detail="Keeps the YouTube, X, Reddit, Facebook, Instagram and Amazon home pages, which Later skips by default. On sites you visit all the time they wait in Regulars.">
          <ToggleSwitch x:Name="FeedSwitch" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnFeedToggled" />
        </controls:SettingRow>
        <controls:SettingRow Glyph="&#xE8CB;" TileBrush="{ThemeResource TileBlueBrush}" Title="Default order"
                             Detail="How your pages are ordered. The toolbar's Sort By changes it too.">
          <ComboBox x:Name="SortBox" MinWidth="190" SelectionChanged="OnSortChanged" />
        </controls:SettingRow>

        <TextBlock Text="Browsers" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,20,0,6" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock x:Name="BrowsersLater" Text="Starts watching after setup." Foreground="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed" Margin="2,0,0,0" />
        <ItemsControl x:Name="BrowserList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:BrowserRowView">
              <Grid MinHeight="52" Padding="14,8" ColumnSpacing="12" CornerRadius="{ThemeResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="28" Height="28" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                  <Image Source="{x:Bind Icon}" Stretch="Uniform" Visibility="{x:Bind HasIcon}" />
                  <FontIcon Glyph="&#xE774;" FontSize="20" IsTextScaleFactorEnabled="False" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="{x:Bind NoIcon}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource StatusGoodBrush}" Visibility="{x:Bind IsGood}" AutomationProperties.AccessibilityView="Raw" />
                  <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource StatusWarningBrush}" Visibility="{x:Bind IsWarning}" AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock Text="{x:Bind Status}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" MaxWidth="200" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Later reads the titles and links of your open tabs, and the browsers' saved site icons and history (read-only, to see when a page was first opened), never private windows. Nothing leaves this PC."
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" Margin="2,6,0,0" />

        <TextBlock Text="Privacy" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,20,0,6" AutomationProperties.HeadingLevel="Level2" />
        <controls:SettingRow Glyph="&#xEA18;" TileBrush="{ThemeResource TileTealBrush}" Title="Block Later from the internet (Windows Firewall)"
                             Detail="Adds a rule that blocks Later's outgoing connections. Later has no networking code either way; this is a second lock.">
          <ToggleSwitch x:Name="FirewallSwitch" OnContent="On" OffContent="Off" MinWidth="0" Toggled="OnFirewallToggled" />
        </controls:SettingRow>
        <TextBlock x:Name="FirewallNote" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords"
                   Margin="2,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

        <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,20,0,6" AutomationProperties.HeadingLevel="Level2" />
        <Border Padding="14,10" CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="4">
            <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Licensed under PolyForm Noncommercial 1.0.0 or PolyForm Small Business 1.0.0, at your choice."
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="-12,2,0,0">
              <HyperlinkButton Content="License" NavigateUri="https://github.com/PrivateVictories-Main/later/blob/main/LICENSE" />
              <HyperlinkButton Content="PRIVACY.md" NavigateUri="https://github.com/PrivateVictories-Main/later/blob/main/PRIVACY.md" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Expander x:Name="Notices" Header="Open-source components" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="OnNoticesExpanding">
          <StackPanel Spacing="8">
            <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="Later is built on Windows App SDK and .NET, both from Microsoft and both under the MIT license." />
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TabNavigation="Local" IsTabStop="True"
                          AutomationProperties.Name="Open-source notices">
              <TextBlock x:Name="NoticesBody" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
          </StackPanel>
        </Expander>

        <Button x:Name="QuitButton" Content="Quit Later" Margin="0,16,0,0" Click="OnQuit" />
        <TextBlock Text="Later keeps watching in the background while 'Start at sign-in' is on." Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" Margin="2,6,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
