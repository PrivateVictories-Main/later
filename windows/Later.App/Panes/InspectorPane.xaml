<UserControl x:Class="Later.App.Panes.InspectorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="KindGlyph" TargetType="FontIcon">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="24" />
    </Style>
    <Style x:Key="KindName" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KindCount" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>
  </UserControl.Resources>
  <!-- Nothing selected: an overview of the list. Task 8 adds the details of one page and the summary of several. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24,20,24,24" Spacing="20">
      <StackPanel Spacing="2">
        <TextBlock Text="Overview" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock x:Name="Caption" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Text="By kind" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" Margin="0,0,0,4" />
        <Grid x:Name="ShoppingRow" ColumnSpacing="12" MinHeight="32">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE719;" Style="{StaticResource KindGlyph}" Foreground="{ThemeResource KindShoppingBrush}" />
          <TextBlock Grid.Column="1" Text="Shopping" Style="{StaticResource KindName}" />
          <TextBlock x:Name="ShoppingCount" Grid.Column="2" Style="{StaticResource KindCount}" />
        </Grid>
        <Grid x:Name="PostsRow" ColumnSpacing="12" MinHeight="32">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE8F2;" Style="{StaticResource KindGlyph}" Foreground="{ThemeResource KindPostsBrush}" />
          <TextBlock Grid.Column="1" Text="Posts" Style="{StaticResource KindName}" />
          <TextBlock x:Name="PostsCount" Grid.Column="2" Style="{StaticResource KindCount}" />
        </Grid>
        <Grid x:Name="SchoolRow" ColumnSpacing="12" MinHeight="32">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE7BE;" Style="{StaticResource KindGlyph}" Foreground="{ThemeResource KindSchoolBrush}" />
          <TextBlock Grid.Column="1" Text="School" Style="{StaticResource KindName}" />
          <TextBlock x:Name="SchoolCount" Grid.Column="2" Style="{StaticResource KindCount}" />
        </Grid>
        <Grid x:Name="ReadingRow" ColumnSpacing="12" MinHeight="32">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE736;" Style="{StaticResource KindGlyph}" Foreground="{ThemeResource KindReadingBrush}" />
          <TextBlock Grid.Column="1" Text="Reading" Style="{StaticResource KindName}" />
          <TextBlock x:Name="ReadingCount" Grid.Column="2" Style="{StaticResource KindCount}" />
        </Grid>
        <Grid x:Name="VideosRow" ColumnSpacing="12" MinHeight="32">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE714;" Style="{StaticResource KindGlyph}" Foreground="{ThemeResource KindVideosBrush}" />
          <TextBlock Grid.Column="1" Text="Videos" Style="{StaticResource KindName}" />
          <TextBlock x:Name="VideosCount" Grid.Column="2" Style="{StaticResource KindCount}" />
        </Grid>
        <Grid x:Name="ToolsRow" ColumnSpacing="12" MinHeight="32">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE90F;" Style="{StaticResource KindGlyph}" Foreground="{ThemeResource KindToolsBrush}" />
          <TextBlock Grid.Column="1" Text="Tools" Style="{StaticResource KindName}" />
          <TextBlock x:Name="ToolsCount" Grid.Column="2" Style="{StaticResource KindCount}" />
        </Grid>
        <Grid x:Name="OtherRow" ColumnSpacing="12" MinHeight="32">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE80A;" Style="{StaticResource KindGlyph}" Foreground="{ThemeResource KindOtherBrush}" />
          <TextBlock Grid.Column="1" Text="Other" Style="{StaticResource KindName}" />
          <TextBlock x:Name="OtherCount" Grid.Column="2" Style="{StaticResource KindCount}" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
