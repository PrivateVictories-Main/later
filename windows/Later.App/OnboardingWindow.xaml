<Window x:Class="Later.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Later.App"
        Title="Welcome to Later">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Later's violet fading out behind the icon (nothing in high contrast). -->
    <Border Grid.RowSpan="3" VerticalAlignment="Top" Height="380" IsHitTestVisible="False" Opacity="{ThemeResource WashOpacity}" AutomationProperties.AccessibilityView="Raw">
      <Border.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Color="{ThemeResource WashStartColor}" Offset="0" />
          <GradientStop Color="{ThemeResource WashEndColor}" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid x:Name="TitleBar" Grid.Row="0" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="PageStack" Padding="40,8,40,24" Spacing="0">

        <StackPanel HorizontalAlignment="Center" Spacing="10">
          <Image Source="ms-appx:///Assets/Later-512.png" Width="116" Height="116" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Text="Welcome to Later" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords"
                     Margin="0,6,0,0" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="Close tabs freely. Later keeps the ones worth coming back to." Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Normal" FontSize="17"
                     Foreground="{ThemeResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Border Margin="0,28,0,0" Padding="20" CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="16">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Background="{ThemeResource TileIndigoBrush}" AutomationProperties.AccessibilityView="Raw">
                <FontIcon Glyph="&#xE735;" FontSize="15" Foreground="{ThemeResource TileGlyphBrush}" IsTextScaleFactorEnabled="False" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Saves what you linger on" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="A product, a post or an assignment you spend a while on is saved, sorted by kind." Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" />
              </StackPanel>
            </Grid>
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Background="{ThemeResource TileOrangeBrush}" AutomationProperties.AccessibilityView="Raw">
                <FontIcon Glyph="&#xE7B3;" FontSize="15" Foreground="{ThemeResource TileGlyphBrush}" IsTextScaleFactorEnabled="False" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Never touches your tabs" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="It never opens or closes a tab on its own. Close any tab, anytime." Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" />
              </StackPanel>
            </Grid>
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Background="{ThemeResource TileGreenBrush}" AutomationProperties.AccessibilityView="Raw">
                <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="{ThemeResource TileGlyphBrush}" IsTextScaleFactorEnabled="False" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Stays on this PC" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="Later contains no networking code, and its build is checked to prove it, so your list never leaves this PC." Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Margin="0,26,0,0" Spacing="10">
          <StackPanel Spacing="3" Margin="4,0,4,0">
            <TextBlock Text="Browsers Later can read" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="Windows needs no permission for this: Later reads the tab titles and links that your open browser windows show on screen, never private windows."
                       Style="{StaticResource CaptionTextBlockStyle}" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" />
          </StackPanel>
          <Border CornerRadius="{ThemeResource OverlayCornerRadius}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  Background="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid>
              <ItemsControl x:Name="BrowserList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:BrowserRowView">
                    <Grid Padding="14,12" ColumnSpacing="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="30" Height="30" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <Image Source="{x:Bind Icon}" Stretch="Uniform" Visibility="{x:Bind HasIcon}" />
                        <FontIcon Glyph="&#xE774;" FontSize="22" IsTextScaleFactorEnabled="False" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="{x:Bind NoIcon}" />
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource StatusGoodBrush}" Visibility="{x:Bind IsGood}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{x:Bind Status}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" MaxWidth="160" VerticalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border x:Name="NoBrowser" Padding="14" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" Text="Later works with Helium and Chrome. Install one, then open Later again." />
              </Border>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Margin="4,22,4,0" Spacing="3">
          <TextBlock Text="Starts with Windows" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="Later starts quietly when you sign in, so it keeps saving pages even when its window is closed. Turn this off in Settings."
                     Style="{StaticResource CaptionTextBlockStyle}" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="WrapWholeWords" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- The one way on. It stays in view however tall the text is; Enter presses it. -->
    <StackPanel Grid.Row="2" Padding="40,12,40,22" Spacing="10">
      <TextBlock x:Name="FailureText" Foreground="{ThemeResource StatusWarningBrush}" TextWrapping="WrapWholeWords" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
      <Button x:Name="StartButton" Content="Start Using Later" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              MinHeight="44" FontWeight="SemiBold" Click="OnStart">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Enter" />
        </Button.KeyboardAccelerators>
      </Button>
      <TextBlock Text="You can change this anytime in Settings." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords" />
    </StackPanel>
  </Grid>
</Window>
