<UserControl x:Class="Later.App.Controls.UndoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
  <!-- What was just done, with its Undo, for a few seconds at the foot of the list. Ctrl+Z works whether or not this is showing. -->
  <Border CornerRadius="8" Padding="16,8,8,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Message" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
      <Button x:Name="UndoButton" Grid.Column="1" Content="Undo" AutomationProperties.Name="Undo" AutomationProperties.AcceleratorKey="Control+Z" Click="OnUndo" />
    </Grid>
  </Border>
</UserControl>
