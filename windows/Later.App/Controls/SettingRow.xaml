<UserControl x:Class="Later.App.Controls.SettingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One setting as a card: a colored tile with a symbol, its name and one line on what it does, and its control at the right (under the
       text when the text is large, so a long name never squeezes against the control). -->
  <Grid x:Name="Card" MinHeight="64" Padding="14,10" ColumnSpacing="14"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Name="TileBorder" Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center" Background="{ThemeResource TileIndigoBrush}">
      <FontIcon x:Name="Symbol" FontSize="16" Foreground="{ThemeResource TileGlyphBrush}" IsTextScaleFactorEnabled="False"
                HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
      <TextBlock x:Name="TitleText" TextWrapping="WrapWholeWords" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="DetailText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}"
                 TextWrapping="WrapWholeWords" AutomationProperties.AccessibilityView="Raw" />
    </StackPanel>
    <ContentPresenter x:Name="AccessoryHost" Grid.Column="2" VerticalAlignment="Center" />
  </Grid>
</UserControl>
