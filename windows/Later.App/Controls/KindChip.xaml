<UserControl x:Class="Later.App.Controls.KindChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A kind's symbol and name in its color (light, dark and high contrast come with the brushes). -->
  <StackPanel x:Name="Chip" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Colors">
        <VisualState x:Name="Shopping"><VisualState.Setters>
          <Setter Target="Symbol.Foreground" Value="{ThemeResource KindShoppingBrush}" /><Setter Target="KindText.Foreground" Value="{ThemeResource KindShoppingBrush}" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="Posts"><VisualState.Setters>
          <Setter Target="Symbol.Foreground" Value="{ThemeResource KindPostsBrush}" /><Setter Target="KindText.Foreground" Value="{ThemeResource KindPostsBrush}" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="School"><VisualState.Setters>
          <Setter Target="Symbol.Foreground" Value="{ThemeResource KindSchoolBrush}" /><Setter Target="KindText.Foreground" Value="{ThemeResource KindSchoolBrush}" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="Reading"><VisualState.Setters>
          <Setter Target="Symbol.Foreground" Value="{ThemeResource KindReadingBrush}" /><Setter Target="KindText.Foreground" Value="{ThemeResource KindReadingBrush}" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="Videos"><VisualState.Setters>
          <Setter Target="Symbol.Foreground" Value="{ThemeResource KindVideosBrush}" /><Setter Target="KindText.Foreground" Value="{ThemeResource KindVideosBrush}" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="Tools"><VisualState.Setters>
          <Setter Target="Symbol.Foreground" Value="{ThemeResource KindToolsBrush}" /><Setter Target="KindText.Foreground" Value="{ThemeResource KindToolsBrush}" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="Other"><VisualState.Setters>
          <Setter Target="Symbol.Foreground" Value="{ThemeResource KindOtherBrush}" /><Setter Target="KindText.Foreground" Value="{ThemeResource KindOtherBrush}" />
        </VisualState.Setters></VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <FontIcon x:Name="Symbol" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
    <TextBlock x:Name="KindText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
  </StackPanel>
</UserControl>
