<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>com.ryan.later</string>
    <key>CFBundleName</key><string>Later</string>
    <key>CFBundleDisplayName</key><string>Later</string>
    <key>CFBundleExecutable</key><string>Later</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.2.0</string>
    <key>CFBundleVersion</key><string>12</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIconName</key><string>AppIcon</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>LSUIElement</key><true/>
    <!-- Hands freed memory back to macOS instead of keeping it cached: about 11 MB less while Later sits in the background. -->
    <key>LSEnvironment</key><dict><key>MallocSpaceEfficient</key><string>1</string></dict>
    <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
    <key>NSAppleEventsUsageDescription</key><string>Later reads the titles and links of your open tabs so it can remember the ones you'll want later. Nothing leaves your Mac.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
</dict>
</plist>
